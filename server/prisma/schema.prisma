generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USERS & IDENTITY ============

enum UserRole {
  USER
  SUPPORT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  SELF_EXCLUDED
  CLOSED
}

model User {
  id           String     @id @default(uuid())
  publicId     String     @unique @default(cuid()) // e.g. BET62-XXXXXX shown to the user
  email        String     @unique
  username     String     @unique
  passwordHash String
  name         String?
  phone        String?
  birthDate    DateTime?
  addressLine  String?
  country      String?    @default("PT")
  currency     String     @default("EUR")
  locale       String     @default("pt")
  oddsFormat   String     @default("decimal")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  wallet             Wallet?
  kycSubmissions     KycSubmission[]
  refreshTokens      RefreshToken[]
  bankAccounts       BankAccount[]
  withdrawals        Withdrawal[]
  deposits           Deposit[]
  limits             ResponsibleGamblingLimits?
  selfExclusions     SelfExclusion[]
  auditLogs          AuditLog[]

  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============ KYC / AML ============

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum KycDocType {
  CITIZEN_CARD
  PASSPORT
  DRIVING_LICENSE
}

model KycSubmission {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType          KycDocType
  docNumber        String
  status           KycStatus  @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime   @default(now())

  @@index([userId])
  @@index([status])
}

// ============ RESPONSIBLE GAMBLING ============

model ResponsibleGamblingLimits {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyDepositLimit      Decimal  @default(500) @db.Decimal(14, 2)
  weeklyLossLimit        Decimal  @default(1000) @db.Decimal(14, 2)
  sessionTimeLimitMinutes Int     @default(120)
  realityCheckEnabled    Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model SelfExclusion {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startAt   DateTime  @default(now())
  endAt     DateTime? // null = permanent
  reason    String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([userId, active])
}

// ============ WALLET / LEDGER ============

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  BET_PLACED
  BET_WON
  BET_REFUND
  BONUS
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency     String   @default("EUR")
  balance      Decimal  @default(0) @db.Decimal(14, 2)
  lockedBalance Decimal @default(0) @db.Decimal(14, 2) // reserved for pending withdrawals
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries            LedgerEntry[]
  deposits           Deposit[]
  withdrawals        Withdrawal[]
  casinoTransactions CasinoTransaction[]
}

model LedgerEntry {
  id            String            @id @default(uuid())
  walletId      String
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          LedgerEntryType
  status        LedgerEntryStatus @default(COMPLETED)
  amount        Decimal           @db.Decimal(14, 2) // positive = credit, negative = debit
  balanceAfter  Decimal           @db.Decimal(14, 2)
  referenceType String? // "deposit" | "withdrawal" | "bet" ...
  referenceId   String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

// ============ CASINO (slots — Cassino Gold Palace, seamless wallet) ============
// Contrato confirmado pelo utilizador: callbacks Win/Cancel/Status que o provedor chama para
// debitar/creditar a carteira do jogador em tempo real. `transGuid` é o identificador único de
// cada transação enviado pelo provedor — usado aqui como chave de idempotência (o próprio
// contrato pede para verificarmos "41: [transação] já processada" e "42: ID existe" antes de
// aplicar qualquer movimento).

enum CasinoTxType {
  BET // aposta debitada (type: 2 na doc, "amount" é o valor apostado)
  WIN // prémio creditado (type: 2 no callback "win", mas semanticamente um crédito)
  CANCEL // estorno de uma aposta/prémio anterior (type: 16 na doc)
  BONUS_CALL_WIN // BonusCall(32) em vez de Win(2) — não afeta o RTP nem os pontos do agente
}

model CasinoTransaction {
  id                String       @id @default(uuid())
  walletId          String
  wallet            Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transGuid         String       @unique // idempotência: um pedido repetido com o mesmo trans_guid não é reaplicado
  cancelOfTransGuid String? // preenchido em CANCEL: aponta para o trans_guid que está a ser estornado
  type              CasinoTxType
  gplayId           String // ID da partida (gplay_id)
  account           String // identificador do jogador tal como enviado pelo provedor (userId interno)
  roundId           String
  providerId        Int
  gameCode          String
  gameType          String
  amount            Decimal      @db.Decimal(14, 2) // valor da operação, sempre positivo
  callId            String? // ID da chamada de bónus, quando aplicável (Bonus Call Feature)
  ledgerEntryId     String? // LedgerEntry criado por esta transação (null se saldo insuficiente/rejeitada)
  createdAt         DateTime     @default(now())

  @@index([walletId, createdAt])
  @@index([roundId])
}

// ============ DEPOSITS (Stripe: card / MB WAY / Multibanco) ============

enum DepositProvider {
  STRIPE_CARD
  STRIPE_MBWAY
  STRIPE_MULTIBANCO
}

enum DepositStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Deposit {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  provider      DepositProvider
  amount        Decimal         @db.Decimal(14, 2)
  currency      String          @default("EUR")
  status        DepositStatus   @default(PENDING)
  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique
  multibancoEntity     String?
  multibancoReference  String?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, status])
  @@index([stripeSessionId])
  @@index([stripePaymentIntentId])
}

// ============ WITHDRAWALS (Revolut Business payout) ============

enum WithdrawalMethod {
  REVOLUT_PAYOUT
  BANK_TRANSFER
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountHolder String
  iban          String
  bic           String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  withdrawals Withdrawal[]

  @@index([userId])
}

model Withdrawal {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId         String
  wallet           Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bankAccountId    String?
  bankAccount      BankAccount?      @relation(fields: [bankAccountId], references: [id])
  method           WithdrawalMethod  @default(REVOLUT_PAYOUT)
  amount           Decimal           @db.Decimal(14, 2)
  currency         String            @default("EUR")
  status           WithdrawalStatus  @default(REQUESTED)
  revolutPaymentId String?           @unique
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, status])
}

// ============ AUDIT (compliance) ============

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ============ ADMIN (painel administrativo) ============
// O catálogo de jogos do Cassino (casino/catalog.ts) vem de um ficheiro JSON estático do
// provedor (games.json) — sem base de dados própria, não há como o admin desativar um jogo
// específico (ex: RTP reportado com problema) sem editar o ficheiro à mão. Esta tabela guarda só
// a exceção manual (override) por cima do catálogo: ausência de registo = usa `launch_enable` do
// JSON tal como está; um registo aqui força ligado/desligado independentemente do JSON.
model CasinoGameOverride {
  gameCode        String   @id
  enabled         Boolean
  updatedByUserId String
  updatedAt       DateTime @updatedAt
}

// Configurações globais da plataforma editáveis pelo admin sem precisar de novo deploy (ex:
// modo de manutenção, limites por omissão). Par chave/valor genérico em vez de colunas fixas —
// evita uma migração por cada nova definição; o valor é validado no service.ts, não aqui.
model PlatformSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

// ============ MAPEAMENTO PULSESCORE <-> API-FOOTBALL ============
// Antes desta tabela, cada pedido de estatísticas/H2H/previsões/classificação repetia a
// pesquisa por nome na API-Football do zero (apifootball/client.ts::searchTeam/searchLeague) —
// nunca guardava o resultado, por isso o mesmo jogo pagava o custo da pesquisa difusa de nomes
// em CADA pedido, e nunca aprendia com correspondências já confirmadas. Ver
// server/src/modules/sports/mapping/ e docs/TEAM_MAPPING.md para o motor que preenche estas
// tabelas (normalização, aliases, pontuação de confiança, cache permanente).
//
// IMPORTANTE: a Pulsescore nunca devolve um id de equipa estável em nenhuma amostra real
// confirmada até agora (só o nome "home"/"away" dentro de cada evento) — por isso não existe um
// "pulsescore_team_id" verdadeiro para guardar. `normalizedPulsescoreName` (dentro do mesmo
// desporto) faz esse papel de identidade do lado Pulsescore, com os dados que realmente há.
enum MappingMethod {
  ID_KNOWN // mapping já existia em cache — reaproveitado sem nova pesquisa
  ALIAS // bateu por um alias conhecido (TeamAlias)
  NORMALIZED // nome normalizado bateu exatamente
  SIMILARITY // similaridade de texto + liga/país/data
  MANUAL // corrigido à mão pelo admin — tem sempre prioridade sobre o automático
}

model TeamMapping {
  id                       String        @id @default(uuid())
  sport                    String
  apiFootballTeamId        Int?
  apiFootballName          String?
  normalizedApiName        String?
  pulsescoreName           String
  normalizedPulsescoreName String
  country                  String?
  confidence               Int // 0-100
  mappingMethod            MappingMethod
  verified                 Boolean       @default(false)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  homeFixtures FixtureMapping[] @relation("HomeTeamMapping")
  awayFixtures FixtureMapping[] @relation("AwayTeamMapping")

  @@unique([sport, normalizedPulsescoreName])
  @@index([sport, normalizedApiName])
  @@index([apiFootballTeamId])
}

model LeagueMapping {
  id                       String        @id @default(uuid())
  sport                    String
  apiFootballLeagueId      Int?
  apiFootballName          String?
  season                   Int?
  pulsescoreName           String
  normalizedPulsescoreName String
  country                  String?
  confidence               Int
  mappingMethod            MappingMethod
  verified                 Boolean       @default(false)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  fixtures FixtureMapping[]

  @@unique([sport, normalizedPulsescoreName])
}

// Uma linha por evento Pulsescore (pulsescoreEventKey = LiveEvent.id completo, ex:
// "pulsescore:30759040") — inclui resultados de baixa confiança (apiFootballFixtureId null,
// confidence<70) para NUNCA repetir a pesquisa cara para o mesmo evento a cada pedido (ver
// "Cache do mapping" em docs/TEAM_MAPPING.md); esses ficam disponíveis para revisão no painel
// admin em vez de martelar a API-Football sem necessidade.
model FixtureMapping {
  id                   String          @id @default(uuid())
  pulsescoreEventKey   String          @unique
  apiFootballFixtureId Int?
  homeTeamMappingId    String?
  homeTeamMapping      TeamMapping?    @relation("HomeTeamMapping", fields: [homeTeamMappingId], references: [id], onDelete: SetNull)
  awayTeamMappingId    String?
  awayTeamMapping      TeamMapping?    @relation("AwayTeamMapping", fields: [awayTeamMappingId], references: [id], onDelete: SetNull)
  leagueMappingId      String?
  leagueMapping        LeagueMapping?  @relation(fields: [leagueMappingId], references: [id], onDelete: SetNull)
  kickoffPulsescore    DateTime?
  kickoffApiFootball   DateTime?
  confidence           Int
  mappingMethod        MappingMethod
  verified             Boolean         @default(false)
  reason               String? // motivo/sinais usados, legível — ver logs [MATCHING] no service
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([apiFootballFixtureId])
  @@index([confidence])
}

// Dicionário de aliases — permite ensinar o sistema a reconhecer "Man Utd" == "Manchester
// United" sem tocar em código (nem redeploy): editável via painel admin, semeado inicialmente
// com os aliases mais óbvios (ver mapping/aliasSeed.ts).
model TeamAlias {
  id              String   @id @default(uuid())
  alias           String
  normalizedAlias String
  canonicalName   String
  sport           String   @default("football")
  createdAt       DateTime @default(now())

  @@unique([sport, normalizedAlias])
}
