generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USERS & IDENTITY ============

enum UserRole {
  USER
  SUPPORT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  SELF_EXCLUDED
  CLOSED
}

model User {
  id           String     @id @default(uuid())
  publicId     String     @unique @default(cuid()) // e.g. BET62-XXXXXX shown to the user
  email        String     @unique
  username     String     @unique
  passwordHash String
  name         String?
  phone        String?
  birthDate    DateTime?
  addressLine  String?
  country      String?    @default("PT")
  currency     String     @default("EUR")
  locale       String     @default("pt")
  oddsFormat   String     @default("decimal")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  wallet             Wallet?
  kycSubmissions     KycSubmission[]
  kycDocuments       KycDocument[]
  refreshTokens      RefreshToken[]
  bankAccounts       BankAccount[]
  withdrawals        Withdrawal[]
  deposits           Deposit[]
  limits             ResponsibleGamblingLimits?
  selfExclusions     SelfExclusion[]
  auditLogs          AuditLog[]
  bets               Bet[]
  casinoAccount      CasinoAccount?

  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============ KYC / AML ============

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum KycDocType {
  CITIZEN_CARD
  PASSPORT
  DRIVING_LICENSE
}

model KycSubmission {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType          KycDocType
  docNumber        String
  status           KycStatus  @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime   @default(now())

  @@index([userId])
  @@index([status])
}

enum KycDocumentType {
  ID_DOCUMENT    // documento de identificação pessoal (cartão de cidadão/passaporte/carta)
  BANK_STATEMENT // extrato bancário — prova de que o IBAN indicado pertence ao utilizador
}

// Ficheiros enviados pelo utilizador para a verificação KYC/AML — em complemento a
// KycSubmission (que só guarda o tipo/número do documento, texto). Guardado em disco local
// (uploads/kyc/, ver users/service.ts) — NEEDS VALIDATION antes de produção: um redeploy no
// Railway sem volume persistente configurado apaga ficheiros locais; produção real precisa de
// um volume persistente do Railway ou armazenamento externo (S3/R2), documentado em
// docs/KYC_DOCUMENTS.md.
model KycDocument {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        KycDocumentType
  fileName    String // nome original enviado pelo utilizador (só para exibição, nunca usado como caminho no disco)
  storagePath String // caminho relativo dentro da pasta de uploads
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime        @default(now())

  @@index([userId])
}

// ============ RESPONSIBLE GAMBLING ============

model ResponsibleGamblingLimits {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyDepositLimit      Decimal  @default(500) @db.Decimal(14, 2)
  weeklyLossLimit        Decimal  @default(1000) @db.Decimal(14, 2)
  sessionTimeLimitMinutes Int     @default(120)
  realityCheckEnabled    Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model SelfExclusion {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startAt   DateTime  @default(now())
  endAt     DateTime? // null = permanent
  reason    String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([userId, active])
}

// ============ WALLET / LEDGER ============

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  BET_PLACED
  BET_WON
  BET_REFUND
  BONUS
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency     String   @default("EUR")
  balance      Decimal  @default(0) @db.Decimal(14, 2)
  lockedBalance Decimal @default(0) @db.Decimal(14, 2) // reserved for pending withdrawals
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries     LedgerEntry[]
  deposits    Deposit[]
  withdrawals Withdrawal[]
  bets        Bet[]
}

model LedgerEntry {
  id            String            @id @default(uuid())
  walletId      String
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          LedgerEntryType
  status        LedgerEntryStatus @default(COMPLETED)
  amount        Decimal           @db.Decimal(14, 2) // positive = credit, negative = debit
  balanceAfter  Decimal           @db.Decimal(14, 2)
  referenceType String? // "deposit" | "withdrawal" | "bet" ...
  referenceId   String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

// ============ SPORTS BETTING ============
// Simples = cada seleção do boletim vira o seu próprio Bet (1 seleção, stake próprio) — nunca
// combinadas. Múltipla = todas as seleções do boletim viram UM único Bet com N BetSelection e
// um stake combinado (odd total = produto das odds individuais), nunca duas seleções do mesmo
// evento (resultados correlacionados). Ver betting/service.ts.

enum BetType {
  SIMPLES
  MULTIPLA
  BET_BUILDER // seleções combinadas do MESMO evento (ex: "United vence" + "Over 2.5 golos" +
  // "Ambas Marcam") — ao contrário da Múltipla, que proíbe expressamente duas seleções do mesmo
  // evento (resultados correlacionados). Só permitido nas 5 categorias que o motor de liquidação
  // automática já sabe resolver sozinho (Resultado/Golos/BTTS/Escanteios/Cartões — ver
  // betting/settlementRules.ts::classifyForBetBuilder) — mercados de jogador (remates,
  // assistências, faltas, impedimentos, passes) ficam de fora por não haver, em lado nenhum
  // desta integração, dados por jogador para os liquidar sem inventar o resultado.
}

enum BetStatus {
  PENDING      // a aguardar o fim do(s) evento(s)
  WON
  LOST
  VOID         // evento cancelado/adiado — stake devolvido, nunca contado como ganho nem perda
  NEEDS_REVIEW // o mercado não é de um tipo que o motor de liquidação automática sabe resolver (ver betting/settlement.ts) — fica visível na fila de revisão manual do admin
}

enum BetSelectionStatus {
  PENDING
  WON
  LOST
  VOID
  NEEDS_REVIEW
}

model Bet {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String
  wallet          Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type            BetType
  stake           Decimal   @db.Decimal(14, 2)
  totalOdd        Decimal   @db.Decimal(10, 3) // produto das odds das seleções (Múltipla) ou a odd única (Simples) no momento da colocação
  potentialReturn Decimal   @db.Decimal(14, 2) // stake * totalOdd, calculado na colocação — informativo, o payout real é recalculado na liquidação (ver nota em settlement.ts sobre seleções VOID)
  status          BetStatus @default(PENDING)
  payout          Decimal?  @db.Decimal(14, 2) // valor realmente creditado (WON) ou devolvido (VOID) — null enquanto PENDING
  settledAt       DateTime?
  createdAt       DateTime  @default(now())

  selections BetSelection[]

  @@index([userId, status])
  @@index([status])
}

model BetSelection {
  id             String              @id @default(uuid())
  betId          String
  bet            Bet                 @relation(fields: [betId], references: [id], onDelete: Cascade)
  eventId        String // LiveEvent.id (ex: "pulsescore:12345") — efémero, não há tabela de eventos própria
  sport          String
  league         String
  home           String
  away           String
  market         String // nome bruto do mercado tal como veio da Pulsescore no momento da aposta (ex: "Match Odds")
  selection      String // rótulo da seleção escolhida (ex: "1", "Over", "Sim")
  odd            Decimal             @db.Decimal(10, 3) // odd travada no momento da aposta — nunca recalculada depois
  kickoffAt      DateTime? // event.startTime no momento da aposta — usado só pela vassoura de segurança (settlement.ts) para saber quando um evento já devia ter terminado há muito e nunca chegou o evento "remove" (ex: reinício do servidor a meio do jogo)
  status         BetSelectionStatus  @default(PENDING)
  finalHomeScore Int?
  finalAwayScore Int?
  settledAt      DateTime?

  @@index([betId])
  @@index([eventId])
  @@index([status])
}

// ============ DEPOSITS (Stripe: card / MB WAY / Multibanco) ============

enum DepositProvider {
  STRIPE_CARD
  STRIPE_MBWAY
  STRIPE_MULTIBANCO
}

enum DepositStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Deposit {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  provider      DepositProvider
  amount        Decimal         @db.Decimal(14, 2)
  currency      String          @default("EUR")
  status        DepositStatus   @default(PENDING)
  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique
  multibancoEntity     String?
  multibancoReference  String?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, status])
  @@index([stripeSessionId])
  @@index([stripePaymentIntentId])
}

// ============ WITHDRAWALS (Revolut Business payout) ============

enum WithdrawalMethod {
  REVOLUT_PAYOUT
  BANK_TRANSFER
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountHolder String
  iban          String
  bic           String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  withdrawals Withdrawal[]

  @@index([userId])
}

model Withdrawal {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId         String
  wallet           Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bankAccountId    String?
  bankAccount      BankAccount?      @relation(fields: [bankAccountId], references: [id])
  method           WithdrawalMethod  @default(REVOLUT_PAYOUT)
  amount           Decimal           @db.Decimal(14, 2)
  currency         String            @default("EUR")
  status           WithdrawalStatus  @default(REQUESTED)
  revolutPaymentId String?           @unique
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, status])
}

// ============ AUDIT (compliance) ============

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ============ ADMIN (painel administrativo) ============
// Configurações globais da plataforma editáveis pelo admin sem precisar de novo deploy (ex:
// modo de manutenção, limites por omissão). Par chave/valor genérico em vez de colunas fixas —
// evita uma migração por cada nova definição; o valor é validado no service.ts, não aqui.
model PlatformSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

// ============ MAPEAMENTO PULSESCORE <-> API-FOOTBALL ============
// Antes desta tabela, cada pedido de estatísticas/H2H/previsões/classificação repetia a
// pesquisa por nome na API-Football do zero (apifootball/client.ts::searchTeam/searchLeague) —
// nunca guardava o resultado, por isso o mesmo jogo pagava o custo da pesquisa difusa de nomes
// em CADA pedido, e nunca aprendia com correspondências já confirmadas. Ver
// server/src/modules/sports/mapping/ e docs/TEAM_MAPPING.md para o motor que preenche estas
// tabelas (normalização, aliases, pontuação de confiança, cache permanente).
//
// IMPORTANTE: a Pulsescore nunca devolve um id de equipa estável em nenhuma amostra real
// confirmada até agora (só o nome "home"/"away" dentro de cada evento) — por isso não existe um
// "pulsescore_team_id" verdadeiro para guardar. `normalizedPulsescoreName` (dentro do mesmo
// desporto) faz esse papel de identidade do lado Pulsescore, com os dados que realmente há.
enum MappingMethod {
  ID_KNOWN // mapping já existia em cache — reaproveitado sem nova pesquisa
  ALIAS // bateu por um alias conhecido (TeamAlias)
  NORMALIZED // nome normalizado bateu exatamente
  SIMILARITY // similaridade de texto + liga/país/data
  MANUAL // corrigido à mão pelo admin — tem sempre prioridade sobre o automático
}

model TeamMapping {
  id                       String        @id @default(uuid())
  sport                    String
  apiFootballTeamId        Int?
  apiFootballName          String?
  normalizedApiName        String?
  pulsescoreName           String
  normalizedPulsescoreName String
  country                  String?
  confidence               Int // 0-100
  mappingMethod            MappingMethod
  verified                 Boolean       @default(false)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  homeFixtures FixtureMapping[] @relation("HomeTeamMapping")
  awayFixtures FixtureMapping[] @relation("AwayTeamMapping")

  @@unique([sport, normalizedPulsescoreName])
  @@index([sport, normalizedApiName])
  @@index([apiFootballTeamId])
}

model LeagueMapping {
  id                       String        @id @default(uuid())
  sport                    String
  apiFootballLeagueId      Int?
  apiFootballName          String?
  season                   Int?
  pulsescoreName           String
  normalizedPulsescoreName String
  country                  String?
  confidence               Int
  mappingMethod            MappingMethod
  verified                 Boolean       @default(false)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  fixtures FixtureMapping[]

  @@unique([sport, normalizedPulsescoreName])
}

// Uma linha por evento Pulsescore (pulsescoreEventKey = LiveEvent.id completo, ex:
// "pulsescore:30759040") — inclui resultados de baixa confiança (apiFootballFixtureId null,
// confidence<70) para NUNCA repetir a pesquisa cara para o mesmo evento a cada pedido (ver
// "Cache do mapping" em docs/TEAM_MAPPING.md); esses ficam disponíveis para revisão no painel
// admin em vez de martelar a API-Football sem necessidade.
model FixtureMapping {
  id                   String          @id @default(uuid())
  pulsescoreEventKey   String          @unique
  apiFootballFixtureId Int?
  homeTeamMappingId    String?
  homeTeamMapping      TeamMapping?    @relation("HomeTeamMapping", fields: [homeTeamMappingId], references: [id], onDelete: SetNull)
  awayTeamMappingId    String?
  awayTeamMapping      TeamMapping?    @relation("AwayTeamMapping", fields: [awayTeamMappingId], references: [id], onDelete: SetNull)
  leagueMappingId      String?
  leagueMapping        LeagueMapping?  @relation(fields: [leagueMappingId], references: [id], onDelete: SetNull)
  kickoffPulsescore    DateTime?
  kickoffApiFootball   DateTime?
  confidence           Int
  mappingMethod        MappingMethod
  verified             Boolean         @default(false)
  reason               String? // motivo/sinais usados, legível — ver logs [MATCHING] no service
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([apiFootballFixtureId])
  @@index([confidence])
}

// Dicionário de aliases — permite ensinar o sistema a reconhecer "Man Utd" == "Manchester
// United" sem tocar em código (nem redeploy): editável via painel admin, semeado inicialmente
// com os aliases mais óbvios (ver mapping/aliasSeed.ts).
model TeamAlias {
  id              String   @id @default(uuid())
  alias           String
  normalizedAlias String
  canonicalName   String
  sport           String   @default("football")
  createdAt       DateTime @default(now())

  @@unique([sport, normalizedAlias])
}

// ============ CASSINO (catálogo local) ============
// Espelho local de POST /v4/game/all (goldslotpalase.com) — o catálogo completo tem milhares de
// jogos e demora demasiado a pedir ao provedor em cada carregamento de página; esta tabela é
// preenchida por um sync manual (ver casino/catalogSync.ts) e é o que o frontend passa a
// consultar. Reconstrução passo a passo, ver docs/CASINO_SLOTS.md.
model CasinoGame {
  id              String   @id @default(uuid())
  providerId      Int
  gameCode        String
  gameName        String
  localeName      String
  gameImage       String
  gameImageNarrow String
  launchEnable    Boolean  @default(true)
  category        String
  regDate         String // tal como veio do provedor ("YYYY-MM-DD HH:MM:SS"), guardado em bruto
  syncedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerId, gameCode])
  @@index([category])
  @@index([launchEnable])
}

// ============ CASSINO (conta no provedor + callback / carteira em tempo real) ============
// Contrato de callback confirmado pelo utilizador (documentação real do goldslotpalase.com,
// não um curl+resposta como o resto — ver docs/CASINO_SLOTS.md). O provedor chama
// POST https://bet62.plus/callback (fora de /api/, ver app.ts) para autenticar, consultar
// saldo, debitar apostas, creditar ganhos e cancelar — ver casino/callback.ts para a
// implementação e para tudo o que ainda não está confirmado (forma dos erros, o campo "check",
// e se "account" == exatamente o que enviamos em user/create).

// Uma linha por utilizador que já tem conta criada no provedor via POST /v4/user/create —
// "account" é o identificador enviado nesse pedido (hoje: user.publicId) e que o provedor
// devolve depois nos comandos "authenticate"/"balance" do callback.
model CasinoAccount {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   String   @unique
  createdAt DateTime @default(now())
}

// Um registo por trans_guid recebido no callback (comandos bet/win/cancel) — chave de
// idempotência: se o provedor reenviar o mesmo trans_guid (timeout do lado dele, retry), a
// carteira não é debitada/creditada outra vez, só se devolve o saldo já processado.
model CasinoCallbackTransaction {
  id         String   @id @default(uuid())
  transGuid  String   @unique
  command    String // "bet" | "win" | "cancel"
  gplayId    String
  account    String
  roundId    String
  providerId Int
  gameCode   String
  gameType   String
  amount     Decimal  @db.Decimal(14, 2)
  type       Int
  createdAt  DateTime @default(now())

  @@index([account, createdAt])
}
