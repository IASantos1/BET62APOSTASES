# ---------- Server ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://bet62:password@localhost:5432/bet62?schema=public

# ---------- JWT ----------
# Generate strong random secrets, e.g.: openssl rand -hex 48
JWT_ACCESS_SECRET=troque_por_um_segredo_aleatorio_de_pelo_menos_32_caracteres
JWT_REFRESH_SECRET=troque_por_outro_segredo_aleatorio_de_pelo_menos_32_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---------- Stripe (depósitos: cartão, MB WAY, Multibanco) ----------
# https://dashboard.stripe.com/apikeys — usar chaves de TESTE (sk_test_...) até ter licença/aprovação para gambling
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=sandbox

# ---------- Revolut Business (levantamentos / payouts) ----------
# https://business.revolut.com/ -> Settings -> APIs
REVOLUT_ENV=sandbox
REVOLUT_CLIENT_ID=
REVOLUT_CLIENT_SECRET=
REVOLUT_PRIVATE_KEY=
REVOLUT_ACCOUNT_ID=

# ---------- Pulsescore (odds: futebol, ténis, basquete, hóquei, beisebol, voleibol, F1, MMA) ----------
# Contrato confirmado via exemplo real — ver docs/SPORTS_DATA.md. O valor abaixo vai no header
# "x-secret", não numa query string.
PULSESCORE_API_KEY=
PULSESCORE_REST_URL=https://api.pulsescore.net/api
PULSESCORE_BOOKMAKER=paddypower

# ---------- API-Football (estatísticas) ----------
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ---------- Cassino Gold Palace / goldslotpalase.com (slots, seamless wallet) ----------
# O provedor chama os nossos callbacks Win/Cancel/Status com este token no header
# "Callback-Token" — tem de bater com o valor configurado no admin do goldslotpalase.com.
CASINO_CALLBACK_TOKEN=
# Confirmado via Swagger real (agent.goldslotpalase.com/swagger/v4/swagger.json).
CASINO_PROVIDER_BASE_URL=https://agent.goldslotpalase.com
# Token de agente (Bearer) gerado no admin do goldslotpalase.com — Home > API > Main API.
CASINO_AGENT_KEY=
