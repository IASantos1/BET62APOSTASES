# ---------- Server ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://bet62:password@localhost:5432/bet62?schema=public

# ---------- JWT ----------
# Generate strong random secrets, e.g.: openssl rand -hex 48
JWT_ACCESS_SECRET=troque_por_um_segredo_aleatorio_de_pelo_menos_32_caracteres
JWT_REFRESH_SECRET=troque_por_outro_segredo_aleatorio_de_pelo_menos_32_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---------- Stripe (depósitos: cartão, MB WAY, Multibanco — tudo confirmado dentro do nosso
# próprio layout, sem redirecionar para uma página da Stripe, ver docs/PAYMENTS.md) ----------
# https://dashboard.stripe.com/apikeys — usar chaves de TESTE (sk_test_.../pk_test_...) até ter
# licença/aprovação para gambling (ver docs/COMPLIANCE.md), só depois trocar para as live reais.
# STRIPE_MODE tem de bater certo com o prefixo da chave secreta (sandbox=sk_test_, live=sk_live_)
# — client.ts recusa arrancar se não baterem, para nunca aceitar depósitos no modo errado sem dar
# por isso. STRIPE_PUBLISHABLE_KEY (pk_test_/pk_live_) É necessária agora — é servida ao browser
# via GET /config.js para montar o Card Element; sem ela o depósito por cartão falha com um erro
# claro em vez de silenciosamente.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=sandbox

# ---------- Revolut Business (levantamentos / payouts) ----------
# https://business.revolut.com/ -> Settings -> APIs
REVOLUT_ENV=sandbox
REVOLUT_CLIENT_ID=
REVOLUT_CLIENT_SECRET=
REVOLUT_PRIVATE_KEY=
REVOLUT_ACCOUNT_ID=

# ---------- Pulsescore (odds: futebol, ténis, basquete, hóquei, beisebol, voleibol, F1, MMA) ----------
# Contrato confirmado via exemplo real — ver docs/SPORTS_DATA.md. O valor abaixo vai no header
# "x-secret", não numa query string.
PULSESCORE_API_KEY=
PULSESCORE_REST_URL=https://api.pulsescore.net/api
PULSESCORE_BOOKMAKER=paddypower

# ---------- API-Football (estatísticas) ----------
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ---------- Documentos KYC (upload de documento pessoal + extrato bancário) ----------
# Caminho local onde os ficheiros ficam guardados — precisa de um volume persistente do
# Railway montado neste caminho em produção, ver docs/KYC_DOCUMENTS.md.
KYC_UPLOAD_DIR=uploads/kyc

# ---------- Cassino Gold Palace / goldslotpalase.com (Agent API v4) ----------
# Reconstruído passo a passo, endpoint a endpoint, ver docs/CASINO_SLOTS.md.
# Token de agente (Bearer) gerado no admin do goldslotpalase.com.
CASINO_AGENT_KEY=
CASINO_PROVIDER_BASE_URL=https://agent.goldslotpalase.com
