# ---------- Server ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://bet62:password@localhost:5432/bet62?schema=public

# ---------- JWT ----------
# Generate strong random secrets, e.g.: openssl rand -hex 48
JWT_ACCESS_SECRET=troque_por_um_segredo_aleatorio_de_pelo_menos_32_caracteres
JWT_REFRESH_SECRET=troque_por_outro_segredo_aleatorio_de_pelo_menos_32_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---------- Stripe (depósitos: cartão, MB WAY, Multibanco) ----------
# https://dashboard.stripe.com/apikeys — usar chaves de TESTE (sk_test_...) até ter licença/aprovação para gambling
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=sandbox

# ---------- Revolut Business (levantamentos / payouts) ----------
# https://business.revolut.com/ -> Settings -> APIs
REVOLUT_ENV=sandbox
REVOLUT_CLIENT_ID=
REVOLUT_CLIENT_SECRET=
REVOLUT_PRIVATE_KEY=
REVOLUT_ACCOUNT_ID=

# ---------- Pulsescore (live odds/scores: futebol, ténis, basquete) ----------
PULSESCORE_API_KEY=
PULSESCORE_WS_URL=wss://stream.pulsescore.com/v1
PULSESCORE_REST_URL=https://api.pulsescore.com/v1

# ---------- API-Football (estatísticas) ----------
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Enquanto não há chaves da Pulsescore, usa dados simulados para a plataforma ficar demonstrável
SPORTS_DATA_MOCK_FALLBACK=true
